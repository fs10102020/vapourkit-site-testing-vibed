---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FloatingToggle from '../components/FloatingToggle.astro';
import ComparisonSlider from '../components/ComparisonSlider.astro';
import Lightbox from '../components/Lightbox.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { base } from '../lib/base';

const features = [
  {
    icon: 'chip',
    title: 'Dual backends',
    desc: 'TensorRT (NVIDIA) or DirectML (AMD, Intel, NV). Switch at runtime.',
  },
  {
    icon: 'eye',
    title: 'Real-time preview',
    desc: 'See results as they process — no waiting for renders. Tweak filters and watch the output update instantly.',
    colSpan: 'md:col-span-2',
  },
  {
    icon: 'split',
    title: 'Compare viewer',
    desc: 'Built-in side-by-side video comparison. Drag the slider to see your restoration against the original.',
  },
  {
    icon: 'grid',
    title: 'Batch processing',
    desc: 'Queue multiple videos with custom workflows. Walk away and come back to finished results.',
  },
  {
    icon: 'code',
    title: 'Custom filters',
    desc: 'Write your own filters, or install any VapourSynth script or plugin from the community.',
  },
  {
    icon: 'save',
    title: 'Templates & workflows',
    desc: 'Save and share .vkfilter and .vkworkflow files — portable, versionable, reproducible.',
    colSpan: 'md:col-span-3',
  },
];

const screenshots = [
  { caption: 'Batch processor', src: 'pictures/Batch View.png' },
  { caption: 'Filter panel', src: 'pictures/Filter Panel.png' },
];

const sysreqs = [
  { label: 'OS', value: 'Windows 10/11 (x64)' },
  { label: 'RAM', value: '8 GB +' },
  { label: 'Storage', value: '5 GB min · 10 GB recommended' },
  { label: 'GPU', value: 'NVIDIA 16xx+ or any DX12-capable card' },
  { label: 'VRAM', value: '6 GB +' },
];

const videos = [
  { src: 'https://www.youtube-nocookie.com/embed/bQ4f-w2gub0?rel=0', title: 'SpongeBob Season 1 remaster', caption: 'SpongeBob Season 1 remaster' },
  { src: 'https://www.youtube-nocookie.com/embed/dPt9NtzQ_04?rel=0', title: 'VHS Restoration Sample', caption: 'VHS Restoration Sample' },
];

const filterCategories = [
  { name: 'Deinterlacing', filters: ['QTGMC', 'BWDIF'] },
  { name: 'Frame Interpolation', filters: ['RIFE'] },
  { name: 'Restoration', filters: ['TemporalFix', 'Remove Dirt MC'] },
  { name: 'Denoising', filters: ['DFTTest2', 'KNLMeans'] },
  { name: 'Sharpening', filters: ['CAS Sharpen', 'LSFmod'] },
  { name: 'Anti-Aliasing', filters: ['DAA', 'SangNom'] },
  { name: 'Dehalo', filters: ['HQDering', 'FineDehalo'] },
  { name: 'Debanding', filters: ['GradFun3', 'f3kdb'] },
];

const socialLinkClass = 'inline-flex h-8 w-8 items-center justify-center rounded-md border border-vk-border/10 text-vk-text-muted transition-colors hover:border-vk-border/20 hover:text-vk-text';
const chipClass = 'inline-flex rounded-lg border border-vk-border/5 bg-vk-bg px-4 py-2 text-sm text-vk-text transition-colors hover:border-vk-accent/20';
const ctaPrimaryClass = 'inline-flex items-center gap-2 rounded-lg border border-vk-accent/25 px-5 py-2 text-sm text-vk-text transition-colors hover:border-vk-accent/50 hover:bg-vk-accent/5';
const ctaSecondaryClass = 'inline-flex items-center gap-2 rounded-lg border border-vk-border/10 px-5 py-2 text-sm text-vk-text-muted transition-colors hover:border-vk-border/20 hover:text-vk-text';
---

<Layout grain>
  <!-- Top nav -->
  <header
    class="sticky top-0 z-40 border-b border-vk-border/10 bg-vk-bg/75 backdrop-blur-md"
  >
    <div class="mx-auto max-w-6xl px-6">
      <!-- Main row: real destinations -->
      <div class="flex items-center justify-between py-3.5">
        <div class="flex items-center gap-8">
          <a href={base} class="flex items-center gap-2.5">
            <img src={`${base}favicon.svg`} alt="" class="h-6 w-6" />
            <strong class="font-display text-lg font-normal tracking-tight">Vapourkit</strong>
          </a>
          <nav class="hidden md:flex items-center gap-6 text-sm text-vk-text-muted">
            <a href="#features" class="section-link hover:text-vk-text transition-colors">Features</a>
            <a href="#tour" class="section-link hover:text-vk-text transition-colors">Screenshots</a>
            <a href="#filters" class="section-link hover:text-vk-text transition-colors">Filters</a>
            <a href="#models" class="section-link hover:text-vk-text transition-colors">Models</a>
            <a href="#community" class="section-link hover:text-vk-text transition-colors">Community</a>
          </nav>
        </div>
        <nav class="flex items-center gap-3 text-sm text-vk-text-muted md:gap-6">
          <a href={`${base}introduction/`} class="hover:text-vk-text transition-colors">Docs</a>
          <a href={`${base}reference/troubleshooting/`} class="hidden hover:text-vk-text transition-colors md:inline">FAQ</a>
          <div class="flex items-center gap-2">
            <a href="https://github.com/Kim2091/vapourkit" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class={socialLinkClass}>
              <Icon name="github" size={15} />
            </a>
            <a href="https://discord.gg/uYKMn2hGwB" target="_blank" rel="noopener noreferrer" aria-label="Discord" class={socialLinkClass}>
              <Icon name="discord" size={15} />
            </a>
            <a href="https://ko-fi.com/kim20913944" target="_blank" rel="noopener noreferrer" aria-label="Ko-fi" class={socialLinkClass}>
              <Icon name="coffee" size={15} />
            </a>
          </div>
          <a
            href="https://ko-fi.com/s/2e5ebd456d"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden rounded-md border border-vk-brand-gold/35 bg-vk-elevated px-3.5 py-1.5 font-medium text-vk-text transition-colors hover:border-vk-brand-gold/65 md:inline-block"
          >
            Download
          </a>
        </nav>
      </div>
      <!-- Subheader: in-page anchors (mobile only) -->
      <nav
        class="subheader-nav flex md:hidden h-9 items-center justify-start gap-8 overflow-x-auto whitespace-nowrap border-t border-vk-border/8 text-[11px] tracking-[0.12em] text-vk-text-subtle [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        aria-label="Page sections"
      >
        <a href="#features" class="section-link hover:text-vk-text-muted transition-colors">Features</a>
        <a href="#tour" class="section-link hover:text-vk-text-muted transition-colors">Screenshots</a>
        <a href="#filters" class="section-link hover:text-vk-text-muted transition-colors">Filters</a>
        <a href="#models" class="section-link hover:text-vk-text-muted transition-colors">Models</a>
        <a href="#community" class="section-link hover:text-vk-text-muted transition-colors">Community</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 py-24 lg:py-36 text-center">
      <div
        class="pointer-events-none absolute inset-0 hero-glow"
      >
      </div>
      <div class="relative z-10 mx-auto max-w-4xl">
        <h1 class="font-display text-4xl font-normal leading-[1.08] tracking-tight text-vk-text sm:text-5xl lg:text-7xl animate-fade-in-up">
          Restore and upscale video,<br />
          <span class="text-vk-accent animate-fade-in-up delay-200">beautifully.</span>
        </h1>
        <p class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-vk-text-muted animate-fade-in-up delay-400 sm:text-xl">
          FOSS video restoration for Windows.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-3 animate-fade-in-up delay-500">
          <a
            href="https://ko-fi.com/s/2e5ebd456d"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-vk-brand-gold px-6 py-2.5 text-sm font-medium text-black transition-colors hover:bg-vk-brand-gold-soft"
          >
            Download Free
          </a>
          <a
            href="https://github.com/Kim2091/vapourkit"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-lg border border-vk-border/10 px-6 py-2.5 text-sm text-vk-text-muted transition-colors hover:border-vk-border/20 hover:text-vk-text"
          >
            <Icon name="github" size={16} />
            <span>View on GitHub</span>
          </a>
        </div>

        <!-- Hero screenshot -->
        <div class="mx-auto mt-20 max-w-4xl animate-fade-in-up delay-700">
          <div class="rounded-2xl border border-vk-border/5 bg-black/40 p-1.5 shadow-2xl shadow-black/50 animate-float-simple">
            <img
              src={`${base}pictures/Main Screen.png`}
              alt="Vapourkit main upscale view"
              width="2065"
              height="1260"
              class="block h-auto w-full rounded-xl"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="border-t border-vk-border/8 px-6 py-20 reveal">
      <div class="mx-auto max-w-6xl">
        <SectionHeading overline="Features" title="Everything you need." />
        <div
          class="grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3"
        >
          {
            features.map((f) => (
              <div class={`group bg-vk-surface-2 p-6 rounded-xl border border-vk-border/5 transition-all duration-300 hover:-translate-y-1 hover:border-vk-accent/15 hover:shadow-lg hover:shadow-black/20 ${f.colSpan || ''}`}>
                <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg border border-vk-accent/25 bg-vk-accent/6 group-hover:border-vk-accent/40 group-hover:bg-vk-accent/10 transition-colors duration-300">
                  <Icon name={f.icon} size={18} stroke="rgb(var(--vk-accent))" />
                </div>
                <h3 class="text-sm font-semibold text-vk-text group-hover:text-vk-accent transition-colors duration-300">{f.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-vk-text-muted">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Before / After -->
    <section id="tour" class="px-6 py-20 reveal">
      <div class="mx-auto max-w-6xl">
        <SectionHeading overline="Before / After" title="See the difference." />
        <div class="space-y-10">
          {videos.map((v) => (
            <figure>
              <div class="relative rounded-2xl border border-vk-border/8 bg-black/40 p-1 shadow-2xl shadow-black/40">
                <div class="aspect-video relative overflow-hidden rounded-xl">
                  <iframe
                    src={v.src}
                    title={v.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    class="block h-full w-full"></iframe>
                  <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-vk-border/5 rounded-xl"></div>
                </div>
              </div>
              <figcaption class="mt-3 text-center text-xs text-vk-text-subtle">
                {v.caption}
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="mt-10">
          <ComparisonSlider label="Interactive comparison" />
        </div>
      </div>
    </section>

    <!-- Tour -->
    <section class="border-t border-vk-border/8 px-6 py-20 reveal">
      <div class="mx-auto max-w-6xl">
        <SectionHeading overline="Tour" title="A look around." />
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            screenshots.map((s) => (
              <figure data-lightbox tabindex="0" role="button" class="group relative cursor-pointer overflow-hidden rounded-2xl border border-vk-border/5 bg-black/20 transition-all duration-300 hover:border-vk-border/10">
                <img
                  src={`${base}${s.src}`}
                  alt={s.caption}
                  class="block aspect-video w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-1.5 bg-black/0 transition-colors duration-300 group-hover:bg-black/40" aria-hidden="true">
                  <Icon name="expand" size={28} stroke="white" class="opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                  <span class="opacity-0 transition-opacity duration-300 group-hover:opacity-100 text-xs font-medium text-white">Click to expand</span>
                </div>
                <figcaption class="relative border-t border-vk-border/5 px-4 py-3 text-[11px] text-vk-text-subtle">
                  {s.caption}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>
    <Lightbox />

    <!-- Filters -->
    <section id="filters" class="border-t border-vk-border/8 px-6 py-20 reveal">
      <div class="mx-auto max-w-3xl rounded-2xl border border-vk-border/5 bg-vk-surface-2 p-8 md:p-10">
        <SectionHeading
          overline="Filters"
          title="Bundled filters, or write your own."
          description="157 filters across 34 categories — deinterlace, denoise, sharpen, restore."
        />
        <div class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
          {filterCategories.map((cat) => (
            <div>
              <h3 class="mb-2 text-[11px] tracking-[0.08em] text-vk-text-subtle">{cat.name}</h3>
              <div class="flex flex-wrap gap-1.5">
                {cat.filters.map((f) => (<div class={chipClass}>{f}</div>))}
              </div>
            </div>
          ))}
        </div>
        <div class="mt-6 rounded-lg border border-dashed border-vk-border/10 px-4 py-3 text-center text-sm text-vk-text-muted transition-colors hover:border-vk-accent/20">
          + Custom filters — write your own VapourSynth scripts
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={`${base}filters/reference/`} class={ctaPrimaryClass}>
            View all filters <Icon name="arrow-right" size={12} />
          </a>
          <a href={`${base}filters/writing/`} class={ctaSecondaryClass}>
            Write your own <Icon name="arrow-right" size={12} />
          </a>
        </div>
      </div>
    </section>

    <!-- Models -->
    <section id="models" class="border-t border-vk-border/8 px-6 py-20 reveal">
      <div class="mx-auto max-w-3xl rounded-2xl border border-vk-border/5 bg-vk-surface-2 p-8 md:p-10">
        <SectionHeading
          overline="Models"
          title="Bundled models, or bring your own."
          description="VSR models are temporally aware — they see across frames for stable output. Image-based models process each frame independently."
        />
        <div class="flex flex-wrap justify-center gap-2">
          <div class={chipClass}>
            TFDAT
            <span class="ml-1.5 rounded-sm bg-vk-accent/12 px-1.5 py-0.5 text-[10px] text-vk-accent">VSR</span>
          </div>
          <div class={chipClass}>AnimeSharpV4</div>
          <div class={chipClass}>UltraSharpV2</div>
          <div class="rounded-lg border border-dashed border-vk-border/10 px-4 py-2 text-sm text-vk-text-muted transition-colors hover:border-vk-accent/20">
            + Custom ONNX
          </div>
        </div>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={`${base}models/included/`} class={ctaPrimaryClass}>
            Browse models <Icon name="arrow-right" size={12} />
          </a>
          <a href={`${base}models/custom-onnx/`} class={ctaSecondaryClass}>
            Bring your own ONNX <Icon name="arrow-right" size={12} />
          </a>
        </div>
      </div>
    </section>

    <!-- System requirements -->
    <section class="border-t border-vk-border/8 px-6 py-20 reveal">
      <div class="mx-auto max-w-6xl">
        <SectionHeading overline="System Requirements" title="Hardware needs." />
        <dl
          class="mx-auto max-w-xl rounded-2xl border border-vk-border/5 bg-vk-surface-2 p-8 text-sm"
        >
          {
            sysreqs.map((r, i) => (
              <div
                class={`flex items-baseline justify-between gap-x-6 py-3 ${i < sysreqs.length - 1 ? 'border-b border-vk-border/5' : ''}`}
              >
                <dt class="font-mono text-xs text-vk-text-muted tracking-wide">{r.label}</dt>
                <dd class="text-right text-vk-text">{r.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Community + Support -->
    <section id="community" class="border-t border-vk-border/8 px-6 py-20 reveal">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-16 md:grid-cols-2 md:gap-10">
        <div class="text-center md:px-8 flex flex-col items-center">
          <SectionHeading overline="Community" title="Join the Discord." />
          <p class="mx-auto mt-4 max-w-md flex-grow text-sm leading-relaxed text-vk-text-muted">
            Share your results, find workflow files shared by others, get help, or request features.
          </p>
          <a
            href="https://discord.gg/uYKMn2hGwB"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-7 inline-flex items-center gap-2 rounded-lg border border-vk-accent/30 bg-vk-surface-2 px-6 py-2.5 text-sm font-medium text-vk-text transition-colors hover:border-vk-accent/50 hover:bg-vk-accent/5"
          >
            <Icon name="discord" size={16} />
            <span>Join Discord</span>
          </a>
        </div>
        <div class="text-center md:px-8 flex flex-col items-center">
          <SectionHeading overline="Support" title="Vapourkit is free. Tips help." />
          <p class="mx-auto mt-4 max-w-md flex-grow text-sm leading-relaxed text-vk-text-muted">
            Donations support my work and help fund development.
          </p>
          <a
            href="https://ko-fi.com/kim20913944"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-7 inline-flex items-center gap-2 rounded-lg bg-vk-brand-gold px-6 py-2.5 text-sm font-medium text-black transition-colors hover:bg-vk-brand-gold-soft"
          >
            <Icon name="coffee" size={14} />
            <span>Ko-fi</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Credits footer -->
  <footer
    class="border-t border-vk-border/8 px-6 py-8 text-center text-[11px] text-vk-text-subtle"
  >
    Copyright &copy; {new Date().getFullYear()} Kim2091
  </footer>

  <FloatingToggle />

  <script is:inline>
    const revealObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          revealObserver.unobserve(entry.target);
        }
      }
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

    const activeNavObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          document.querySelectorAll('.section-link').forEach((a) => {
            a.classList.toggle('active', a.getAttribute('href') === `#${id}`);
          });
        }
      }
    }, { threshold: 0.4 });
    document.querySelectorAll('#features, #tour, #filters, #models, #community').forEach((el) => activeNavObserver.observe(el));
  </script>

</Layout>
