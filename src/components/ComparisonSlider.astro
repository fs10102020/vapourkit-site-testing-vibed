---
interface Props {
  before?: string
  after?: string
}

const { before, after } = Astro.props
---

<div class="comparison-slider relative overflow-hidden rounded-2xl border border-vk-border/8 bg-black/40 p-1 shadow-2xl shadow-black/40">
  <div class="relative aspect-video overflow-hidden rounded-xl">
    {
      before && after ? (
        <>
          <img
            src={before}
            alt="Before restoration"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <img
            src={after}
            alt="After restoration"
            class="absolute inset-0 h-full w-full object-cover comparison-after"
            style="clip-path: inset(0 50% 0 0);"
            loading="lazy"
            decoding="async"
          />
        </>
      ) : (
        <>
          <div class="absolute inset-0 h-full w-full bg-vk-surface-2"></div>
          <div class="absolute inset-0 h-full w-full bg-black/20 comparison-after" style="clip-path: inset(0 50% 0 0);"></div>
        </>
      )
    }
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Comparison slider"
      class="comparison-input"
    />
    <div class="comparison-handle"></div>
  </div>
</div>

<style>
  .comparison-input {
    appearance: none;
    -webkit-appearance: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    z-index: 10;
    cursor: ew-resize;
    margin: 0;
  }
  .comparison-input::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    width: 4px;
    height: 100%;
    background: #a78bfa;
    cursor: ew-resize;
    border: none;
    border-radius: 0;
    box-shadow: 0 0 12px rgba(167, 139, 250, 0.5);
  }
  .comparison-input::-moz-range-thumb {
    width: 4px;
    height: 100%;
    background: #a78bfa;
    cursor: ew-resize;
    border: none;
    border-radius: 0;
    box-shadow: 0 0 12px rgba(167, 139, 250, 0.5);
  }
  .comparison-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #050505;
    border: 3px solid #a78bfa;
    pointer-events: none;
    z-index: 11;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 16px rgba(167, 139, 250, 0.3);
  }
  .comparison-handle::before,
  .comparison-handle::after {
    content: "";
    display: block;
    width: 2px;
    height: 12px;
    background: #a78bfa;
    border-radius: 1px;
  }
  .comparison-handle::after {
    margin-left: 4px;
  }
  .comparison-handle::before {
    margin-right: 4px;
  }
</style>

<script is:inline>
  (() => {
    const container = document.currentScript?.parentElement?.querySelector('.comparison-slider');
    const slider = container?.querySelector('.comparison-input');
    const afterEl = container?.querySelector('.comparison-after');
    const handle = container?.querySelector('.comparison-handle');
    if (slider) {
      const update = () => {
        const v = Number(slider.value);
        if (afterEl) afterEl.style.clipPath = 'inset(0 ' + (100 - v) + '% 0 0)';
        if (handle) handle.style.left = v + '%';
      };
      slider.addEventListener('input', update);
    }
  })();
</script>
